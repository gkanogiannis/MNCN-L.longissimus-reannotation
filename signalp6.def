Bootstrap: docker
From: python:3.9-slim-bullseye

# =============================================================================
# SignalP 6.0 Singularity container
# =============================================================================
# Author: Anestis Gkanogiannis <anestis@gkanogiannis.com> - MNCN-CSIC, 2026
# =============================================================================
# SignalP 6.0 is CPU-only (PyTorch inference, no GPU required).
#
# Build:
#   sudo -E singularity build signalp6.sif signalp6.def
#
# Run:
#   singularity run --bind /data:/data signalp6.sif \
#       --fastafile proteins.faa --output_dir results/ \
#       --organism eukarya --format txt
#
# Or equivalently:
#   singularity exec --bind /data:/data signalp6.sif \
#       signalp6 --fastafile proteins.faa --output_dir results/ \
#       --organism eukarya --format txt
# =============================================================================

%files
    ./signalp6_fast/signalp-6-package /opt/signalp6

%post
    export DEBIAN_FRONTEND=noninteractive

    # ---------- System dependencies ----------
    apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ && \
    rm -rf /var/lib/apt/lists/*

    # Ensure pip is up to date
    pip install --no-cache-dir --upgrade pip setuptools wheel

    # ---------- PyTorch (CPU-only -- keeps image small) ----------
    pip install --no-cache-dir \
        torch --index-url https://download.pytorch.org/whl/cpu

    # Fix: clear executable-stack flag (PF_X in PT_GNU_STACK) that
    # Singularity's security profile blocks. Done via direct ELF edit
    # since execstack/patchelf may not be available at the right version.
    python3 -c "
import struct, glob
for path in glob.glob('/usr/local/lib/**/torch/**/*.so', recursive=True):
    with open(path, 'r+b') as f:
        if f.read(4) != b'\x7fELF': continue
        ei_class, ei_data = struct.unpack('BB', f.read(2))
        if ei_class != 2: continue  # skip non-64-bit
        endian = '<' if ei_data == 1 else '>'
        f.seek(32); e_phoff = struct.unpack(endian+'Q', f.read(8))[0]
        f.seek(54); e_phentsize, e_phnum = struct.unpack(endian+'HH', f.read(4))
        for i in range(e_phnum):
            off = e_phoff + i * e_phentsize
            f.seek(off); p_type = struct.unpack(endian+'I', f.read(4))[0]
            if p_type == 0x6474e551:  # PT_GNU_STACK
                p_flags = struct.unpack(endian+'I', f.read(4))[0]
                if p_flags & 0x1:     # PF_X set
                    f.seek(off + 4)
                    f.write(struct.pack(endian+'I', p_flags & ~0x1))
                    print(f'Cleared exec stack: {path}')
                break
"

    # ---------- Install SignalP 6.0 ----------
    pip install --no-cache-dir /opt/signalp6

    SIGNALP_DIR=$(python3 -c "import signalp; import os; print(os.path.dirname(signalp.__file__))" )
    
    mkdir -p "$SIGNALP_DIR/model_weights"
    cp -av /opt/signalp6/models/. "$SIGNALP_DIR/model_weights/"
    
    pip3 install --no-cache-dir "numpy<2"
    pip3 check
    
    # ---------- Cleanup ----------
    apt-get purge -y gcc g++ && \
    apt-get autoremove -y && apt-get clean && \
    rm -rf /root/.cache/pip

%environment
    export LC_ALL=C
    export PATH="/usr/local/bin:$PATH"
    # Some SignalP versions look for models via this env var
    export SIGNALP6_DIR="/opt/signalp6"

%runscript
    exec signalp6 "$@"

%test
    # Quick sanity check that the binary is available
    signalp6 --help > /dev/null 2>&1

%labels
    Version      6.0
    Description  SignalP 6.0 signal peptide predictor (CPU)
